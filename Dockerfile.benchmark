# syntax=docker/dockerfile:1
FROM golang:1.24-bookworm AS build
WORKDIR /app
ENV GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local
ARG VERSION=dev
ARG GIT_COMMIT=unknown
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY api/ ./api/
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.gitCommit=${GIT_COMMIT}" \
    -o /out/capmesh-benchmark ./cmd/capmesh-benchmark

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/capmesh-benchmark /usr/local/bin/capmesh-benchmark
COPY benchmarks/scenarios/ /benchmarks/scenarios/
ENTRYPOINT ["/usr/local/bin/capmesh-benchmark"]
