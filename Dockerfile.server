# syntax=docker/dockerfile:1
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/capmesh-server ./cmd/capmesh-server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/capmesh-server /usr/local/bin/capmesh-server
EXPOSE 18443 19090
ENTRYPOINT ["/usr/local/bin/capmesh-server"]
